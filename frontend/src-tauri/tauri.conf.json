{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIO Nexus",
  "version": "2.0.0",
  "identifier": "org.aiocrm.nexus",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIO Nexus",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../../backend/*.py",
      "../../backend/blueprints/**/*",
      "../../backend/routes/**/*",
      "../../backend/schemas/**/*",
      "../../backend/utils/**/*",
      "../../backend/requirements.txt"
    ]
  }
}
