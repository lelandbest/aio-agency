    {
      "parameters": {
        "promptType": "define",
        "text": "=Read and analyze this conent  {{ $json.threadId }} as they come in or when requested on demand and categorize them as specified in the system prompt. ",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are an AI email classifier. Your task is to analyze the following email content:\nEmail threadId:{{ $json.threadId }}, Subject {{ $json.subject }} Body: {{ $json.text }} and classify it into one of the following ten (10) categories, the list is NOT all inclusive, use best judgement:\n\nClassify this email into one of these categories:\n1. Urgent & Critical – High-priority support requests, system failures, critical alerts\n2. Customer Support – Non-urgent customer service and product-related questions\n3. Financial & Billing – Invoices, payments, overdue notices, bank notifications\n4. Internal Communications – Company updates, newsletters, schedules, team emails\n5. Legal & Compliance – Contracts, policy updates, government & regulatory matters\n6. Product & Service Requests – Inquiries and requests for business services\n7. Leads & Sales Opportunities – Warm leads, client inquiries, partnership requests\n8. Marketing & Promotions – Cold outreach, advertisements, bulk marketing emails\n9. Spam & Junk – Suspicious emails, phishing, unverified senders, scams\n10. Personal & Miscellaneous – Personal, family, medical, academic, or non-business\n\n\nRespond in strict JSON format: { \"text\": \"EMAIL_CATEGORY\" }\n\nOnly replace EMAIL_CATEGORY with one of the ten (10) categories. Do not include any additional text or sub-category such as 'output'. Take a moment to analyze the content, rate limit yourself to one email per every second.  Output ONLY the text of the category, nothing else."
            }
          ]
        }
      },
